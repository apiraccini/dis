# Only secrets need to be set here. Everything else is optional: commented
# values below show the dev defaults, which live in backend/src/core/config.py
# (and docker-compose.yaml for the db service).

# Postgres
POSTGRES_PASSWORD=dis
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
#POSTGRES_USER=dis
#POSTGRES_DB=dis

# Qdrant
#QDRANT_URL=http://qdrant:6333
#QDRANT_COLLECTION=documents

# Embeddings — any OpenAI-compatible API works; the key is required.
# Default: OpenRouter with Qwen3-Embedding-8B.
OPENROUTER_API_KEY=
#EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
#EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# To use an official OpenAI key instead, uncomment and set:
#EMBEDDING_BASE_URL=https://api.openai.com/v1
#EMBEDDING_MODEL=text-embedding-3-small
#EMBEDDING_INPUT_TYPE_DOCUMENT=   # empty: OpenAI rejects the input_type field
#EMBEDDING_INPUT_TYPE_QUERY=

# VLM-assisted parsing (scanned/image-only PDFs). Off by default; without it,
# scanned documents (e.g. data/final/architecture-overview.pdf) are rejected
# with 422 because no text can be extracted.
#USE_VLM=false
#VLM_MODEL=google/gemini-3.1-flash-lite

# MCP server auth (Bearer token on /mcp). Change in prod.
# Leaving it empty disables MCP auth entirely — local dev only.
MCP_API_KEY=dev-mcp-key-change-me
